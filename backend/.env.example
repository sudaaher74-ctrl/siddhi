# Copy to .env and fill in real values. The server refuses to start without these.

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/siddhi-journal

# Secret used to sign JWTs. Must be long and random — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters when NODE_ENV=production.
JWT_SECRET=

# How long a login stays valid
JWT_EXPIRES_IN=30d

# Comma-separated list of browser origins allowed to call this API
CORS_ORIGIN=http://localhost:3000

PORT=5001
