# Copy to .env and fill in real values.

# Database URL for Turso (LibSQL)
# Local development can use file:siddhi.db or :memory:
# For production on Turso Cloud: libsql://your-db-name.turso.io
TURSO_DATABASE_URL=file:siddhi.db

# Turso Authentication Token (required for remote Turso Cloud database)
TURSO_AUTH_TOKEN=

# Secret used to sign JWTs. Must be long and random — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters when NODE_ENV=production.
JWT_SECRET=

# How long a login stays valid
JWT_EXPIRES_IN=30d

# Comma-separated list of browser origins allowed to call this API
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

PORT=5001

# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=
